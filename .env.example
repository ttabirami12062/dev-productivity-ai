# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PINECONE_API_KEY=
GITHUB_TOKEN=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional: weekly history in Supabase (project URL and secret key). Leave blank to turn it off.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Where links in emails point (defaults to the live site)
SITE_URL=https://dev-productivity-ai.vercel.app
# Optional: Langfuse tracing. Leave the keys blank to turn it off.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Optional: most new reports per visitor per hour, and per day for the whole site (a spending cap)
HOURLY_LIMIT=8
DAILY_LIMIT=300
# Optional: lock the API to your frontend, e.g. https://dev-productivity-ai.vercel.app
ALLOWED_ORIGINS=*
