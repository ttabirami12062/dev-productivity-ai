{
  "test_cases": [
    {
      "id": 1,
      "scenario": "Slow merges with one overloaded reviewer",
      "people": 3,
      "median_merge_hours": 52.0,
      "weekly_hours": [14, 16, 19, 27, 38, 52],
      "open": 4, "stale_open": 3,
      "reviews": {"Alice": 16, "Bob": 2, "Charlie": 2},
      "commits": {"Alice": 12, "Bob": 6, "Charlie": 4},
      "expect_kinds": ["risk", "action", "positive"],
      "expected_keywords": ["review", "alice"]
    },
    {
      "id": 2,
      "scenario": "Healthy team with balanced workload",
      "people": 3,
      "median_merge_hours": 9.0,
      "weekly_hours": [10, 8, 9, 11, 9, 8],
      "open": 2, "stale_open": 0,
      "reviews": {"Alice": 7, "Bob": 6, "Charlie": 7},
      "commits": {"Alice": 10, "Bob": 10, "Charlie": 10},
      "expect_kinds": ["positive"],
      "expected_keywords": ["review"]
    },
    {
      "id": 3,
      "scenario": "Many PRs left open for days",
      "people": 3,
      "median_merge_hours": 36.0,
      "weekly_hours": [20, 24, 30, 33, 35, 36],
      "open": 10, "stale_open": 7,
      "reviews": {"Alice": 8, "Bob": 7, "Charlie": 5},
      "commits": {"Alice": 12, "Bob": 8, "Charlie": 5},
      "expect_kinds": ["risk", "action", "positive"],
      "expected_keywords": ["open"]
    }
  ]
}
